EMBEDDING_API_KEY=replace-with-a-long-random-secret
EMBEDDING_DEVICE=auto
EMBEDDING_USE_FP16=true
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_MODEL_NAME=bge-m3

EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=8192
EMBEDDING_MAX_TOTAL_TOKENS=16384

# Source-build Compose port mapping; registry deployment exposes HTTPS on 80/443.
BIND_HOST=127.0.0.1
PORT=8000

# Optional registry image override: tag or immutable digest.
# EMBEDDING_IMAGE=ghcr.io/toanehihi/embedding-server:latest

# Required by compose.deploy.yaml: domain without scheme or path.
# DNS must point to this EC2 instance; inbound TCP 80/443 must be reachable.
CADDY_DOMAIN=embedding.example.com
